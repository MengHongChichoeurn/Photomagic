  <!-- TOAST NOTIFICATION CONTAINER -->
  <div id="toastContainer" class="fixed bottom-8 right-8 z-50 flex flex-col space-y-2 pointer-events-none"></div>

  <!-- ================= APPLICATION JAVASCRIPT ================= -->
  <script>
    // Global Application State & Storage
    const state = {
      isAdmin: true,
      osMode: 'win', // 'win' or 'mac'
      currentView: 'home', // 'home' or 'workspace'
      activeTool: 'move',
      fgColor: '#007acc',
      bgColor: '#ffffff',
      canvasWidth: 1920,
      canvasHeight: 1080,
      zoomLevel: 1.0,
      layers: [], // array of layer objects { id, name, canvas, ctx, visible, opacity, blend }
      activeLayerIndex: 0,
      history: [],
      show3DWolfOverlay: false,
      recentFiles: [
        { name: 'wolf_render_3d_concept.psd', format: 'PSD', date: '2026-04-18', size: '24.2 MB', width: 1920, height: 1080 },
        { name: 'magic_graphic_cover.png', format: 'PNG', date: '2026-04-15', size: '8.4 MB', width: 1200, height: 1200 },
        { name: 'branding_vector_icon.svg', format: 'SVG', date: '2026-04-10', size: '1.1 MB', width: 800, height: 600 }
      ]
    };

    // DOM Elements Reference
    const mainCanvas = document.getElementById('mainCanvas');
    const mainCtx = mainCanvas.getContext('2d');
    const overlay3DCanvas = document.getElementById('overlay3DCanvas');
    const overlay3DCtx = overlay3DCanvas.getContext('2d');
    const canvasWrapper = document.getElementById('canvasWrapper');

    // Drawing Interaction Variables
    let isDrawing = false;
    let lastX = 0;
    let lastY = 0;

    // Initialization on Page Load
    window.onload = function() {
      renderRecentFiles();
      initCanvasEvents();
      initDragAndDrop();
      triggerToast('Photo Magic Desktop Initialized (kennmagic)');
    };

    // View Navigation Switcher
    function showHomeScreen() {
      state.currentView = 'home';
      document.getElementById('homeView').classList.remove('hidden');
      document.getElementById('workspaceView').classList.add('hidden');
      document.getElementById('headerDocName').textContent = 'Home - Photo Magic Launcher';
    }

    function showWorkspaceView() {
      state.currentView = 'workspace';
      document.getElementById('homeView').classList.add('hidden');
      document.getElementById('workspaceView').classList.remove('hidden');
    }

    // Modal Control Functions
    function openNewModal() { document.getElementById('newFileModal').classList.remove('hidden'); }
    function closeNewModal() { document.getElementById('newFileModal').classList.add('hidden'); }
    function openSettingsModal() { document.getElementById('settingsModal').classList.remove('hidden'); }
    function closeSettingsModal() { document.getElementById('settingsModal').classList.add('hidden'); }
    function openAboutModal() { document.getElementById('aboutModal').classList.remove('hidden'); }
    function closeAboutModal() { document.getElementById('aboutModal').classList.add('hidden'); }

    // Admin Toggle Functionality
    function toggleAdminMode() {
      state.isAdmin = !state.isAdmin;
      const adminBtn = document.getElementById('adminToggleBtn');
      const adminText = document.getElementById('adminText');
      const modalBtn = document.getElementById('modalAdminBtn');

      if (state.isAdmin) {
        adminBtn.className = "flex items-center space-x-1.5 px-2 py-0.5 rounded text-[11px] bg-amber-950/60 text-amber-400 border border-amber-700/50 hover:bg-amber-900/60 transition";
        adminText.textContent = "Run as Administrator";
        modalBtn.textContent = "Elevated Active";
        modalBtn.className = "px-3 py-1.5 bg-amber-600 hover:bg-amber-500 text-white rounded font-medium";
        triggerToast("Administrator Mode Granted");
      } else {
        adminBtn.className = "flex items-center space-x-1.5 px-2 py-0.5 rounded text-[11px] bg-ps-panel text-ps-muted border border-ps-border hover:bg-ps-hover transition";
        adminText.textContent = "Standard User";
        modalBtn.textContent = "Switch to Admin Mode";
        modalBtn.className = "px-3 py-1.5 bg-ps-hover hover:bg-ps-border text-gray-200 rounded font-medium border border-ps-border";
        triggerToast("Switched to Standard Permissions");
      }
    }

    // OS Style Switcher
    function toggleOSStyle() {
      setOSPlatform(state.osMode === 'win' ? 'mac' : 'win');
    }

    function setOSPlatform(os) {
      state.osMode = os;
      const winCtrls = document.getElementById('windowControlsWin');
      const macCtrls = document.getElementById('windowControlsMac');
      const osIcon = document.getElementById('osIcon');
      const osStyleName = document.getElementById('osStyleName');

      if (os === 'mac') {
        winCtrls.classList.add('hidden');
        macCtrls.classList.remove('hidden');
        osIcon.className = "fa-brands fa-apple text-gray-300";
        osStyleName.textContent = "macOS Style";
        document.getElementById('osBadgeText').textContent = "macOS Sonoma Verified";
      } else {
        winCtrls.classList.remove('hidden');
        macCtrls.classList.add('hidden');
        osIcon.className = "fa-brands fa-windows text-blue-400";
        osStyleName.textContent = "Windows Style";
        document.getElementById('osBadgeText').textContent = "Win 11 Verified";
      }
      triggerToast(`Switched OS Layout to ${os === 'mac' ? 'macOS' : 'Windows'}`);
    }

    // Recent Files Rendering
    function renderRecentFiles() {
      const container = document.getElementById('recentFilesContainer');
      container.innerHTML = '';

      state.recentFiles.forEach((file, index) => {
        const item = document.createElement('div');
        item.className = "p-3 bg-ps-panel hover:bg-ps-hover border border-ps-border rounded-lg flex items-center justify-between cursor-pointer transition group";
        item.onclick = () => loadRecentFile(file);

        let iconClass = "fa-file-image text-blue-400";
        if (file.format === 'PSD') iconClass = "fa-layer-group text-purple-400";
        if (file.format === 'SVG') iconClass = "fa-vector-square text-amber-400";

        item.innerHTML = `
          <div class="flex items-center space-x-3">
            <div class="w-8 h-8 rounded bg-ps-bg flex items-center justify-center border border-ps-border group-hover:border-ps-accent">
              <i class="fa-solid ${iconClass}"></i>
            </div>
            <div>
              <div class="text-xs font-semibold text-gray-200 group-hover:text-ps-accent transition">${file.name}</div>
              <div class="text-[10px] text-ps-muted">${file.format} • ${file.width} x ${file.height} px • ${file.size}</div>
            </div>
          </div>
          <span class="text-[10px] text-ps-muted">${file.date}</span>
        `;
        container.appendChild(item);
      });
    }

    function clearRecentFiles() {
      state.recentFiles = [];
      renderRecentFiles();
      triggerToast('Recent File History Cleared');
    }

    function loadRecentFile(file) {
      createNewDocument(file.name, file.width, file.height, '#ffffff');
      triggerToast(`Opened Recent Project: ${file.name}`);
    }

    // Document Creation Handler
    function handleCreateNewDocument(e) {
      e.preventDefault();
      const name = document.getElementById('docNameInput').value || 'Untitled Project';
      const width = parseInt(document.getElementById('docWidthInput').value) || 1920;
      const height = parseInt(document.getElementById('docHeightInput').value) || 1080;
      const bg = document.getElementById('docBgInput').value;

      createNewDocument(name, width, height, bg);
      closeNewModal();
    }

    function createPresetCanvas(w, h, name) {
      createNewDocument(name, w, h, '#ffffff');
    }

    function createNewDocument(name, width, height, background) {
      state.canvasWidth = width;
      state.canvasHeight = height;
      state.layers = [];

      // Scale canvas dimensions visually to fit screen
      const maxDisplayW = Math.min(window.innerWidth - 320, width);
      const scale = maxDisplayW / width;
      
      mainCanvas.width = width;
      mainCanvas.height = height;
      overlay3DCanvas.width = width;
      overlay3DCanvas.height = height;

      // Adjust wrapper sizing
      canvasWrapper.style.width = (width * (scale < 1 ? scale : 1)) + 'px';
      canvasWrapper.style.height = (height * (scale < 1 ? scale : 1)) + 'px';

      // Update Top Badges & Labels
      document.getElementById('canvasSizeBadge').textContent = `${width} x ${height} px`;
      document.getElementById('headerDocName').textContent = `${name} @ 100% (${document.getElementById('docColorModeInput')?.value || 'RGB'}/8)`;
      document.getElementById('docDimensionsText').textContent = `${width} x ${height} px`;
      document.getElementById('propWidth').textContent = `${width} px`;
      document.getElementById('propHeight').textContent = `${height} px`;

      // Create Initial Background Layer
      const bgLayer = createLayerObject('Background', width, height);
      if (background !== 'transparent') {
        bgLayer.ctx.fillStyle = background;
        bgLayer.ctx.fillRect(0, 0, width, height);
      }
      state.layers.push(bgLayer);

      // Create Drawing Layer
      const drawLayer = createLayerObject('Layer 1', width, height);
      state.layers.push(drawLayer);
      state.activeLayerIndex = 1;

      renderLayersList();
      compositeLayers();
      showWorkspaceView();
      logHistory(`Created Document (${width}x${height})`);
    }

    // Layer System Management
    function createLayerObject(name, w, h) {
      const canvas = document.createElement('canvas');
      canvas.width = w;
      canvas.height = h;
      return {
        id: 'layer_' + Date.now() + '_' + Math.random().toString(36).substr(2, 4),
        name: name,
        canvas: canvas,
        ctx: canvas.getContext('2d'),
        visible: true,
        opacity: 100,
        blend: 'normal'
      };
    }

    function addNewLayer() {
      const name = `Layer ${state.layers.length}`;
      const newLayer = createLayerObject(name, state.canvasWidth, state.canvasHeight);
      state.layers.push(newLayer);
      state.activeLayerIndex = state.layers.length - 1;
      renderLayersList();
      logHistory('Added New Layer');
    }

    function duplicateActiveLayer() {
      if (state.layers.length === 0) return;
      const current = state.layers[state.activeLayerIndex];
      const dup = createLayerObject(current.name + ' Copy', state.canvasWidth, state.canvasHeight);
      dup.ctx.drawImage(current.canvas, 0, 0);
      state.layers.push(dup);
      state.activeLayerIndex = state.layers.length - 1;
      renderLayersList();
      compositeLayers();
      logHistory('Duplicated Active Layer');
    }

    function deleteActiveLayer() {
      if (state.layers.length <= 1) {
        triggerToast('Cannot delete the last remaining layer');
        return;
      }
      state.layers.splice(state.activeLayerIndex, 1);
      state.activeLayerIndex = Math.max(0, state.activeLayerIndex - 1);
      renderLayersList();
      compositeLayers();
      logHistory('Deleted Active Layer');
    }

    function toggleActiveLayerVisibility() {
      if (state.layers[state.activeLayerIndex]) {
        state.layers[state.activeLayerIndex].visible = !state.layers[state.activeLayerIndex].visible;
        renderLayersList();
        compositeLayers();
      }
    }

    function renderLayersList() {
      const container = document.getElementById('layersList');
      container.innerHTML = '';

      // Render upside down for Photoshop stack feel
      for (let i = state.layers.length - 1; i >= 0; i--) {
        const layer = state.layers[i];
        const item = document.createElement('div');
        const isActive = i === state.activeLayerIndex;

        item.className = `p-2.5 flex items-center justify-between cursor-pointer transition border-b border-ps-border/40 ${
          isActive ? 'bg-ps-accent/20 border-l-4 border-l-ps-accent text-white' : 'hover:bg-ps-hover text-ps-muted'
        }`;
        
        item.onclick = () => {
          state.activeLayerIndex = i;
          renderLayersList();
        };

        item.innerHTML = `
          <div class="flex items-center space-x-2.5 truncate">
            <button onclick="event.stopPropagation(); toggleLayerVisibilityAt(${i})" class="hover:text-white">
              <i class="fa-solid ${layer.visible ? 'fa-eye text-gray-300' : 'fa-eye-slash text-ps-muted'} text-xs"></i>
            </button>
            <div class="w-6 h-6 bg-ps-bg border border-ps-border rounded flex items-center justify-center overflow-hidden">
              <i class="fa-solid fa-image text-[10px]"></i>
            </div>
            <span class="text-xs font-medium truncate">${layer.name}</span>
          </div>
          <span class="text-[10px] text-ps-muted">${layer.opacity}%</span>
        `;
        container.appendChild(item);
      }
    }

    function toggleLayerVisibilityAt(index) {
      state.layers[index].visible = !state.layers[index].visible;
      renderLayersList();
      compositeLayers();
    }

    function updateActiveLayerOpacity(val) {
      if (state.layers[state.activeLayerIndex]) {
        state.layers[state.activeLayerIndex].opacity = parseInt(val);
        document.getElementById('layerOpacityVal').textContent = val + '%';
        compositeLayers();
      }
    }

    function updateActiveLayerBlend() {
      if (state.layers[state.activeLayerIndex]) {
        state.layers[state.activeLayerIndex].blend = document.getElementById('layerBlendMode').value;
        compositeLayers();
      }
    }

    // Composite All Layers into Main Display Canvas
    function compositeLayers() {
      mainCtx.clearRect(0, 0, mainCanvas.width, mainCanvas.height);

      state.layers.forEach(layer => {
        if (!layer.visible) return;
        mainCtx.save();
        mainCtx.globalAlpha = layer.opacity / 100;
        mainCtx.globalCompositeOperation = getCanvasBlendMode(layer.blend);
        mainCtx.drawImage(layer.canvas, 0, 0);
        mainCtx.restore();
      });
    }

    function getCanvasBlendMode(blend) {
      switch (blend) {
        case 'multiply': return 'multiply';
        case 'screen': return 'screen';
        case 'overlay': return 'overlay';
        case 'darken': return 'darken';
        case 'lighten': return 'lighten';
        default: return 'source-over';
      }
    }

    // Interactive Drawing Event Listeners
    function initCanvasEvents() {
      mainCanvas.addEventListener('mousedown', startDrawing);
      mainCanvas.addEventListener('mousemove', draw);
      mainCanvas.addEventListener('mouseup', stopDrawing);
      mainCanvas.addEventListener('mouseleave', stopDrawing);

      // Touch screen support
      mainCanvas.addEventListener('touchstart', (e) => {
        const touch = e.touches[0];
        const mouseEvent = new MouseEvent('mousedown', { clientX: touch.clientX, clientY: touch.clientY });
        mainCanvas.dispatchEvent(mouseEvent);
      });
      mainCanvas.addEventListener('touchmove', (e) => {
        const touch = e.touches[0];
        const mouseEvent = new MouseEvent('mousemove', { clientX: touch.clientX, clientY: touch.clientY });
        mainCanvas.dispatchEvent(mouseEvent);
      });
      mainCanvas.addEventListener('touchend', () => {
        const mouseEvent = new MouseEvent('mouseup', {});
        mainCanvas.dispatchEvent(mouseEvent);
      });
    }

    function getCanvasCoords(e) {
      const rect = mainCanvas.getBoundingClientRect();
      const scaleX = mainCanvas.width / rect.width;
      const scaleY = mainCanvas.height / rect.height;
      return {
        x: (e.clientX - rect.left) * scaleX,
        y: (e.clientY - rect.top) * scaleY
      };
    }

    function startDrawing(e) {
      if (state.layers.length === 0) return;
      isDrawing = true;
      const coords = getCanvasCoords(e);
      lastX = coords.x;
      lastY = coords.y;

      if (state.activeTool === 'text') {
        addTextToLayer(coords.x, coords.y);
        isDrawing = false;
      }
    }

    function draw(e) {
      if (!isDrawing || state.layers.length === 0) return;
      const coords = getCanvasCoords(e);
      const activeLayer = state.layers[state.activeLayerIndex];
      const ctx = activeLayer.ctx;

      const brushSize = parseInt(document.getElementById('brushSizeSlider').value);
      const opacity = parseInt(document.getElementById('brushOpacitySlider').value) / 100;

      ctx.save();
      ctx.globalAlpha = opacity;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      if (state.activeTool === 'brush') {
        ctx.strokeStyle = state.fgColor;
        ctx.lineWidth = brushSize;
        ctx.beginPath();
        ctx.moveTo(lastX, lastY);
        ctx.lineTo(coords.x, coords.y);
        ctx.stroke();
      } else if (state.activeTool === 'eraser') {
        ctx.globalCompositeOperation = 'destination-out';
        ctx.lineWidth = brushSize;
        ctx.beginPath();
        ctx.moveTo(lastX, lastY);
        ctx.lineTo(coords.x, coords.y);
        ctx.stroke();
      } else if (state.activeTool === 'shape') {
        // Clear active temp stroke and draw rectangle
        ctx.fillStyle = state.fgColor;
        ctx.fillRect(coords.x - brushSize, coords.y - brushSize, brushSize * 2, brushSize * 2);
      }

      ctx.restore();
      lastX = coords.x;
      lastY = coords.y;

      compositeLayers();
    }

    function stopDrawing() {
      if (isDrawing) {
        isDrawing = false;
        logHistory(`Used ${state.activeTool.toUpperCase()} Tool`);
      }
    }

    function addTextToLayer(x, y) {
      const text = prompt("Enter text for Canvas:", "Photo Magic");
      if (!text) return;
      const activeLayer = state.layers[state.activeLayerIndex];
      const ctx = activeLayer.ctx;

      const fontSize = document.getElementById('brushSizeSlider').value * 2;
      ctx.font = `bold ${fontSize}px Inter, sans-serif`;
      ctx.fillStyle = state.fgColor;
      ctx.fillText(text, x, y);
      compositeLayers();
      logHistory('Added Text Element');
    }

    // Tools Switcher
    function setTool(toolName) {
      state.activeTool = toolName;
      document.querySelectorAll('aside button').forEach(btn => btn.classList.remove('bg-ps-hover', 'text-ps-accent'));
      const activeBtn = document.getElementById(`tool-${toolName}`);
      if (activeBtn) activeBtn.classList.add('bg-ps-hover', 'text-ps-accent');
      document.getElementById('currentToolLabel').textContent = `Tool: ${toolName.toUpperCase()}`;
    }

    // Color Swatches
    function updateColors() {
      state.fgColor = document.getElementById('fgColorInput').value;
      state.bgColor = document.getElementById('bgColorInput').value;
    }

    function swapColors() {
      const temp = state.fgColor;
      state.fgColor = state.bgColor;
      state.bgColor = temp;
      document.getElementById('fgColorInput').value = state.fgColor;
      document.getElementById('bgColorInput').value = state.bgColor;
    }

    // File Import Handling (PNG, JPG, SVG, PSD, TIF)
    function initDragAndDrop() {
      const dropZone = document.getElementById('dropZone');
      ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        dropZone.addEventListener(eventName, (e) => { e.preventDefault(); e.stopPropagation(); }, false);
      });
      dropZone.addEventListener('drop', (e) => {
        const files = e.dataTransfer.files;
        if (files.length > 0) processImportedFile(files[0]);
      });
    }

    function handleFileImport(e) {
      const files = e.target.files;
      if (files.length > 0) processImportedFile(files[0]);
    }

    function processImportedFile(file) {
      const reader = new FileReader();
      const ext = file.name.split('.').pop().toLowerCase();

      reader.onload = function(evt) {
        if (ext === 'svg' || ext === 'png' || ext === 'jpg' || ext === 'jpeg') {
          const img = new Image();
          img.onload = function() {
            createNewDocument(file.name, img.width || 1200, img.height || 800, '#ffffff');
            const targetLayer = state.layers[state.activeLayerIndex];
            targetLayer.ctx.drawImage(img, 0, 0);
            compositeLayers();
            triggerToast(`Imported Image (${ext.toUpperCase()}): ${file.name}`);
          };
          img.src = evt.target.result;
        } else if (ext === 'psd' || ext === 'tif' || ext === 'tiff') {
          // Simulated layer parser for complex graphics formats
          createNewDocument(file.name, 1920, 1080, '#1e1e1e');
          const activeLayer = state.layers[state.activeLayerIndex];
          const ctx = activeLayer.ctx;

          ctx.fillStyle = '#007acc';
          ctx.font = '24px Inter, sans-serif';
          ctx.fillText(`Parsed Format: ${ext.toUpperCase()} [${file.name}]`, 100, 200);
          ctx.strokeStyle = '#ffffff';
          ctx.lineWidth = 4;
          ctx.strokeRect(80, 150, 600, 300);

          compositeLayers();
          triggerToast(`Parsed Complex File Header: ${file.name}`);
        }
      };

      if (ext === 'svg') reader.readAsText(file);
      else reader.readAsDataURL(file);
    }

    // Image Filter Adjustments
    function applyFilter(filterType) {
      if (state.layers.length === 0) return;
      const activeLayer = state.layers[state.activeLayerIndex];
      const ctx = activeLayer.ctx;
      const imgData = ctx.getImageData(0, 0, state.canvasWidth, state.canvasHeight);
      const data = imgData.data;

      if (filterType === 'grayscale') {
        for (let i = 0; i < data.length; i += 4) {
          const avg = (data[i] + data[i + 1] + data[i + 2]) / 3;
          data[i] = avg;
          data[i + 1] = avg;
          data[i + 2] = avg;
        }
      } else if (filterType === 'invert') {
        for (let i = 0; i < data.length; i += 4) {
          data[i] = 255 - data[i];
          data[i + 1] = 255 - data[i + 1];
          data[i + 2] = 255 - data[i + 2];
        }
      } else if (filterType === 'sepia') {
        for (let i = 0; i < data.length; i += 4) {
          const r = data[i], g = data[i + 1], b = data[i + 2];
          data[i] = Math.min(255, (r * 0.393) + (g * 0.769) + (b * 0.189));
          data[i + 1] = Math.min(255, (r * 0.349) + (g * 0.686) + (b * 0.168));
          data[i + 2] = Math.min(255, (r * 0.272) + (g * 0.534) + (b * 0.131));
        }
      } else if (filterType === 'brightness') {
        for (let i = 0; i < data.length; i += 4) {
          data[i] = Math.min(255, data[i] + 30);
          data[i + 1] = Math.min(255, data[i + 1] + 30);
          data[i + 2] = Math.min(255, data[i + 2] + 30);
        }
      } else if (filterType === 'wolf3d') {
        drawWolf3DWireframe(ctx);
      }

      ctx.putImageData(imgData, 0, 0);
      compositeLayers();
      logHistory(`Applied Filter: ${filterType.toUpperCase()}`);
      triggerToast(`Applied Filter: ${filterType}`);
    }

    // 3D Wolf Overlay Renderer
    function toggle3DOverlay() {
      state.show3DWolfOverlay = !state.show3DWolfOverlay;
      if (state.show3DWolfOverlay) {
        overlay3DCanvas.classList.remove('hidden');
        render3DWolfMesh();
        triggerToast('3D Wolf Wireframe Overlay Rendered');
      } else {
        overlay3DCanvas.classList.add('hidden');
        triggerToast('3D Overlay Hidden');
      }
    }

    function render3DWolfMesh() {
      overlay3DCtx.clearRect(0, 0, overlay3DCanvas.width, overlay3DCanvas.height);
      drawWolf3DWireframe(overlay3DCtx);
    }

    function drawWolf3DWireframe(ctx) {
      const cx = state.canvasWidth / 2;
      const cy = state.canvasHeight / 2;
      const scale = Math.min(state.canvasWidth, state.canvasHeight) / 300;

      ctx.save();
      ctx.translate(cx, cy);
      ctx.scale(scale, scale);

      ctx.strokeStyle = '#00d2ff';
      ctx.lineWidth = 1.5;
      ctx.fillStyle = 'rgba(10, 37, 64, 0.4)';

      const polygons = [
        [ [0, -100], [-45, -50], [0, -20] ],
        [ [0, -100], [0, -20], [45, -50] ],
        [ [-45, -50], [-90, -70], [-60, 0] ],
        [ [45, -50], [90, -70], [60, 0] ],
        [ [0, -20], [-60, 0], [0, 50] ],
        [ [0, -20], [0, 50], [60, 0] ],
        [ [-60, 0], [-96, 10], [-54, 60] ],
        [ [60, 0], [96, 10], [54, 60] ],
        [ [0, 50], [-54, 60], [0, 120] ],
        [ [0, 50], [0, 120], [54, 60] ]
      ];

      polygons.forEach(pts => {
        ctx.beginPath();
        ctx.moveTo(pts[0][0], pts[0][1]);
        ctx.lineTo(pts[1][0], pts[1][1]);
        ctx.lineTo(pts[2][0], pts[2][1]);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
      });

      // Eyes
      ctx.fillStyle = '#00ffea';
      ctx.beginPath();
      ctx.arc(-25, -25, 6, 0, Math.PI * 2);
      ctx.arc(25, -25, 6, 0, Math.PI * 2);
      ctx.fill();

      ctx.restore();
    }

    // Zoom Controls
    function zoomCanvas(delta) {
      state.zoomLevel = Math.max(0.2, Math.min(3.0, state.zoomLevel + delta));
      canvasWrapper.style.transform = `scale(${state.zoomLevel})`;
      document.getElementById('zoomLevelText').textContent = `Zoom: ${Math.round(state.zoomLevel * 100)}%`;
    }

    function resetCanvasZoom() {
      state.zoomLevel = 1.0;
      canvasWrapper.style.transform = `scale(1.0)`;
      document.getElementById('zoomLevelText').textContent = `Zoom: 100%`;
    }

    // Panel Tabs Switcher
    function switchTab(tabName) {
      ['layers', 'properties', 'history'].forEach(t => {
        document.getElementById(`panel-${t}`).classList.add('hidden');
        const tabBtn = document.getElementById(`tab-${t}`);
        tabBtn.classList.remove('border-ps-accent', 'text-white', 'bg-ps-panel');
        tabBtn.classList.add('border-transparent', 'text-ps-muted');
      });

      document.getElementById(`panel-${tabName}`).classList.remove('hidden');
      const activeBtn = document.getElementById(`tab-${tabName}`);
      activeBtn.classList.add('border-ps-accent', 'text-white', 'bg-ps-panel');
      activeBtn.classList.remove('border-transparent', 'text-ps-muted');
    }

    // History Log Management
    function logHistory(action) {
      state.history.push({ action, time: new Date().toLocaleTimeString() });
      const container = document.getElementById('historyList');
      const item = document.createElement('div');
      item.className = "p-2 hover:bg-ps-hover border-b border-ps-border/40 text-ps-muted flex justify-between items-center";
      item.innerHTML = `<span>${action}</span><span class="text-[9px]">${new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</span>`;
      container.prepend(item);
    }

    function clearActiveLayer() {
      if (state.layers[state.activeLayerIndex]) {
        const layer = state.layers[state.activeLayerIndex];
        layer.ctx.clearRect(0, 0, state.canvasWidth, state.canvasHeight);
        compositeLayers();
        logHistory('Cleared Layer');
      }
    }

    // Export Functionality
    function saveCanvasImage() {
      const link = document.createElement('a');
      link.download = 'photo_magic_artwork.png';
      link.href = mainCanvas.toDataURL('image/png');
      link.click();
      triggerToast('Exported Image as PNG');
    }

    function exportPSD() {
      const psdManifest = {
        title: "Photo Magic Project",
        owner: "kennmagic",
        width: state.canvasWidth,
        height: state.canvasHeight,
        layersCount: state.layers.length,
        layers: state.layers.map(l => ({ name: l.name, opacity: l.opacity, blend: l.blend }))
      };
      const blob = new Blob([JSON.stringify(psdManifest, null, 2)], { type: 'application/json' });
      const link = document.createElement('a');
      link.download = 'project_manifest.psd.json';
      link.href = URL.createObjectURL(blob);
      link.click();
      triggerToast('Exported PSD Project Manifest');
    }

    // Toast Notification System
    function triggerToast(message) {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      toast.className = "px-4 py-2 bg-ps-panel border border-ps-accent text-gray-200 text-xs rounded-lg shadow-2xl flex items-center space-x-2 transition transform translate-y-2 opacity-0";
      toast.innerHTML = `<i class="fa-solid fa-wand-magic-sparkles text-ps-accent"></i><span>${message}</span>`;
      
      container.appendChild(toast);
      
      setTimeout(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      }, 50);

      setTimeout(() => {
        toast.classList.add('opacity-0');
        setTimeout(() => toast.remove(), 300);
      }, 2500);
    }
  </script>
</body>
