<!DOCTYPE html>
<html lang="en" class="h-full select-none">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Photo Magic - Desktop Launcher & Workspace</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Fonts Inter -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            ps: {
              bg: '#1e1e1e',
              panel: '#252526',
              header: '#2d2d2d',
              border: '#383838',
              hover: '#3c3c3c',
              accent: '#007acc',
              accentHover: '#0098ff',
              text: '#cccccc',
              muted: '#888888',
              darkBg: '#121212'
            }
          }
        }
      }
    }
  </script>

  <style>
    /* Custom Scrollbar for Photoshop Look */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #1e1e1e;
    }
    ::-webkit-scrollbar-thumb {
      background: #383838;
      border-radius: 3px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #555555;
    }

    /* Range slider custom styling */
    input[type=range] {
      -webkit-appearance: none;
      background: #383838;
      height: 4px;
      border-radius: 2px;
    }
    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none;
      height: 12px;
      width: 12px;
      border-radius: 50%;
      background: #007acc;
      cursor: pointer;
    }

    .canvas-checkerboard {
      background-color: #181818;
      background-image: linear-gradient(45deg, #222 25%, transparent 25%), 
                        linear-gradient(-45deg, #222 25%, transparent 25%), 
                        linear-gradient(45deg, transparent 75%, #222 75%), 
                        linear-gradient(-45deg, transparent 75%, #222 75%);
      background-size: 20px 20px;
      background-position: 0 0, 0 10px, 10px -10px, -10px 0px;
    }

    .glass-effect {
      backdrop-filter: blur(8px);
      background: rgba(30, 30, 30, 0.85);
    }
  </style>
</head>
<body class="bg-ps-bg text-ps-text h-full flex flex-col font-sans overflow-hidden">

  <!-- ================= TOP APP HEADER / TITLEBAR ================= -->
  <header id="titlebar" class="bg-ps-header border-b border-ps-border h-9 flex items-center justify-between px-3 text-xs shrink-0 z-50">
    <!-- Left: App Icon + Branding + Admin Switcher -->
    <div class="flex items-center space-x-3">
      <!-- App Icon SVG (Wolf Wireframe 3D) -->
      <div class="w-6 h-6 rounded flex items-center justify-center overflow-hidden shadow cursor-pointer transition transform hover:scale-105" onclick="showHomeScreen()">
        <svg viewBox="0 0 100 100" class="w-full h-full">
          <defs>
            <radialGradient id="wolfBg" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#0a2540"/>
              <stop offset="100%" stop-color="#020b14"/>
            </radialGradient>
          </defs>
          <rect width="100" height="100" fill="url(#wolfBg)"/>
          <!-- 3D Wolf Wireframe Facets -->
          <g stroke="#111111" stroke-width="1.2" stroke-linejoin="round">
            <polygon points="50,15 35,32 50,42" fill="#a0a5b5"/>
            <polygon points="50,15 50,42 65,32" fill="#c0c5d5"/>
            <polygon points="35,32 20,25 30,48" fill="#787e8e"/>
            <polygon points="65,32 80,25 70,48" fill="#989ea3"/>
            <polygon points="50,42 30,48 50,65" fill="#888e9e"/>
            <polygon points="50,42 50,65 70,48" fill="#a8aebf"/>
            <polygon points="30,48 18,52 32,68" fill="#606573"/>
            <polygon points="70,48 82,52 68,68" fill="#808593"/>
            <polygon points="50,65 32,68 50,88" fill="#707584"/>
            <polygon points="50,65 50,88 68,68" fill="#9095a4"/>
            <polygon points="32,68 40,82 50,88" fill="#505562"/>
            <polygon points="68,68 60,82 50,88" fill="#686d7a"/>
            <!-- Eyes -->
            <polygon points="38,40 45,43 36,46" fill="#00d2ff" stroke="none"/>
            <polygon points="62,40 55,43 64,46" fill="#00d2ff" stroke="none"/>
          </g>
        </svg>
      </div>

      <span class="font-bold text-gray-200 tracking-wide">Photo Magic</span>
      <span class="text-[10px] text-ps-muted bg-ps-panel px-1.5 py-0.5 rounded border border-ps-border">v2026.4 Pro</span>

      <!-- Run as Admin Indicator -->
      <button id="adminToggleBtn" onclick="toggleAdminMode()" class="flex items-center space-x-1.5 px-2 py-0.5 rounded text-[11px] bg-amber-950/60 text-amber-400 border border-amber-700/50 hover:bg-amber-900/60 transition">
        <i class="fa-solid fa-shield-halved text-xs" id="adminIcon"></i>
        <span id="adminText">Run as Administrator</span>
      </button>

      <!-- Platform indicator switch -->
      <div class="hidden sm:flex items-center space-x-1 bg-ps-bg/60 border border-ps-border px-2 py-0.5 rounded text-[10px] text-gray-400">
        <i id="osIcon" class="fa-brands fa-windows text-blue-400"></i>
        <span id="osBadgeText">Win 11 / macOS Sonoma Verified</span>
      </div>
    </div>

    <!-- Center: Project Title -->
    <div class="hidden lg:block font-medium text-gray-300 text-[11px] truncate max-w-xs" id="headerDocName">
      Home - Photo Magic Launcher
    </div>

    <!-- Right: Window Controls / Platform Switcher -->
    <div class="flex items-center space-x-3">
      <!-- OS UI Mode Toggle Button -->
      <button onclick="toggleOSStyle()" class="text-xs text-ps-muted hover:text-white px-2 py-0.5 rounded hover:bg-ps-hover transition" title="Switch OS Window Frame Style (Win / Mac)">
        <i class="fa-solid fa-desktop mr-1"></i> <span id="osStyleName">Windows Style</span>
      </button>

      <!-- Dynamic Window Controls -->
      <div id="windowControlsWin" class="flex items-center space-x-2 text-ps-muted">
        <button class="hover:text-white px-1.5 py-0.5 hover:bg-ps-hover rounded"><i class="fa-solid fa-minus text-[10px]"></i></button>
        <button class="hover:text-white px-1.5 py-0.5 hover:bg-ps-hover rounded"><i class="fa-regular fa-square text-[10px]"></i></button>
        <button class="hover:bg-red-600 hover:text-white px-2 py-0.5 rounded transition"><i class="fa-solid fa-xmark text-xs"></i></button>
      </div>

      <div id="windowControlsMac" class="hidden flex items-center space-x-1.5 pl-2">
        <div class="w-3 h-3 rounded-full bg-red-500 hover:opacity-80 cursor-pointer"></div>
        <div class="w-3 h-3 rounded-full bg-yellow-500 hover:opacity-80 cursor-pointer"></div>
        <div class="w-3 h-3 rounded-full bg-green-500 hover:opacity-80 cursor-pointer"></div>
      </div>
    </div>
  </header>

  <!-- ================= TOP MENU BAR (12 MENUS) ================= -->
  <nav class="bg-ps-panel border-b border-ps-border flex items-center px-2 py-0.5 text-xs text-gray-300 select-none z-40 relative">
    <div class="flex items-center space-x-1" id="topNavMenuList">
      <!-- Menus dynamically or statically rendered -->
      <div class="relative group">
        <button class="px-2.5 py-1 rounded hover:bg-ps-hover focus:bg-ps-hover hover:text-white flex items-center">File</button>
        <div class="hidden group-hover:block absolute left-0 top-full bg-ps-panel border border-ps-border shadow-2xl py-1 min-w-[200px] z-50 rounded-b">
          <a href="#" onclick="openNewModal()" class="flex justify-between px-3 py-1.5 hover:bg-ps-accent hover:text-white"><span class="flex items-center"><i class="fa-solid fa-file-circle-plus mr-2 text-ps-accent"></i>New File...</span><span class="text-ps-muted text-[10px]">Ctrl+N</span></a>
          <label class="flex justify-between px-3 py-1.5 hover:bg-ps-accent hover:text-white cursor-pointer"><span class="flex items-center"><i class="fa-solid fa-folder-open mr-2 text-amber-400"></i>Open / Import...</span><span class="text-ps-muted text-[10px]">Ctrl+O</span>
            <input type="file" id="fileImporter" accept=".png,.jpg,.jpeg,.svg,.psd,.tif,.tiff" class="hidden" onchange="handleFileImport(event)">
          </label>
          <div class="border-t border-ps-border my-1"></div>
          <a href="#" onclick="saveCanvasImage()" class="flex justify-between px-3 py-1.5 hover:bg-ps-accent hover:text-white"><span class="flex items-center"><i class="fa-solid fa-floppy-disk mr-2 text-emerald-400"></i>Save Workspace PNG</span><span class="text-ps-muted text-[10px]">Ctrl+S</span></a>
          <a href="#" onclick="exportPSD()" class="flex justify-between px-3 py-1.5 hover:bg-ps-accent hover:text-white"><span class="flex items-center"><i class="fa-solid fa-file-export mr-2 text-purple-400"></i>Export PSD Manifest</span><span class="text-ps-muted text-[10px]">Shift+Ctrl+S</span></a>
          <div class="border-t border-ps-border my-1"></div>
          <a href="#" onclick="showHomeScreen()" class="flex justify-between px-3 py-1.5 hover:bg-ps-accent hover:text-white"><span><i class="fa-solid fa-house mr-2"></i>Return to Home</span></a>
          <a href="#" onclick="triggerToast('Application Closed Sim')" class="flex justify-between px-3 py-1.5 hover:bg-red-600 hover:text-white"><span><i class="fa-solid fa-power-off mr-2"></i>Exit</span></a>
        </div>
      </div>

      <!-- Edit -->
      <div class="relative group">
        <button class="px-2.5 py-1 rounded hover:bg-ps-hover hover:text-white">Edit</button>
        <div class="hidden group-hover:block absolute left-0 top-full bg-ps-panel border border-ps-border shadow-2xl py-1 min-w-[180px] z-50 rounded-b">
          <a href="#" onclick="undoLastAction()" class="flex justify-between px-3 py-1.5 hover:bg-ps-accent hover:text-white"><span>Undo Stroke</span><span class="text-ps-muted text-[10px]">Ctrl+Z</span></a>
          <a href="#" onclick="clearActiveLayer()" class="flex justify-between px-3 py-1.5 hover:bg-ps-accent hover:text-white"><span>Clear Selected Layer</span><span class="text-ps-muted text-[10px]">Del</span></a>
          <div class="border-t border-ps-border my-1"></div>
          <a href="#" onclick="openSettingsModal()" class="flex justify-between px-3 py-1.5 hover:bg-ps-accent hover:text-white"><span>Preferences...</span><span class="text-ps-muted text-[10px]">Ctrl+K</span></a>
        </div>
      </div>

      <!-- Image -->
      <div class="relative group">
        <button class="px-2.5 py-1 rounded hover:bg-ps-hover hover:text-white">Image</button>
        <div class="hidden group-hover:block absolute left-0 top-full bg-ps-panel border border-ps-border shadow-2xl py-1 min-w-[200px] z-50 rounded-b">
          <a href="#" onclick="applyFilter('brightness')" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white block">Auto Brightness / Contrast</a>
          <a href="#" onclick="applyFilter('grayscale')" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white block">Grayscale Mode</a>
          <a href="#" onclick="applyFilter('invert')" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white block">Invert Colors</a>
          <a href="#" onclick="applyFilter('sepia')" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white block">Sepia Tone</a>
        </div>
      </div>

      <!-- Layer -->
      <div class="relative group">
        <button class="px-2.5 py-1 rounded hover:bg-ps-hover hover:text-white">Layer</button>
        <div class="hidden group-hover:block absolute left-0 top-full bg-ps-panel border border-ps-border shadow-2xl py-1 min-w-[180px] z-50 rounded-b">
          <a href="#" onclick="addNewLayer()" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white block">New Layer</a>
          <a href="#" onclick="duplicateActiveLayer()" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white block">Duplicate Layer</a>
          <a href="#" onclick="deleteActiveLayer()" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white block text-red-400">Delete Active Layer</a>
          <div class="border-t border-ps-border my-1"></div>
          <a href="#" onclick="flattenLayers()" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white block">Flatten Image</a>
        </div>
      </div>

      <!-- Type -->
      <div class="relative group">
        <button class="px-2.5 py-1 rounded hover:bg-ps-hover hover:text-white">Type</button>
        <div class="hidden group-hover:block absolute left-0 top-full bg-ps-panel border border-ps-border shadow-2xl py-1 min-w-[180px] z-50 rounded-b">
          <a href="#" onclick="addTextLayerPrompt()" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white block">Add Text Layer</a>
          <a href="#" onclick="triggerToast('Font Engine Ready: Inter, Sans, Serif')" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white block">Font Settings</a>
        </div>
      </div>

      <!-- Select -->
      <div class="relative group">
        <button class="px-2.5 py-1 rounded hover:bg-ps-hover hover:text-white">Select</button>
        <div class="hidden group-hover:block absolute left-0 top-full bg-ps-panel border border-ps-border shadow-2xl py-1 min-w-[180px] z-50 rounded-b">
          <a href="#" onclick="triggerToast('All Canvas Selected')" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white block">Select All (Ctrl+A)</a>
          <a href="#" onclick="triggerToast('Deselected')" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white block">Deselect (Ctrl+D)</a>
        </div>
      </div>

      <!-- Filter -->
      <div class="relative group">
        <button class="px-2.5 py-1 rounded hover:bg-ps-hover hover:text-white">Filter</button>
        <div class="hidden group-hover:block absolute left-0 top-full bg-ps-panel border border-ps-border shadow-2xl py-1 min-w-[180px] z-50 rounded-b">
          <a href="#" onclick="applyFilter('blur')" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white block">Gaussian Blur</a>
          <a href="#" onclick="applyFilter('sharpen')" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white block">Sharpen Edges</a>
          <a href="#" onclick="applyFilter('glow')" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white block">Neon Glow Effect</a>
          <a href="#" onclick="applyFilter('wolf3d')" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white block text-cyan-400">3D Wolf Wireframe Overlay</a>
        </div>
      </div>

      <!-- 3D -->
      <div class="relative group">
        <button class="px-2.5 py-1 rounded hover:bg-ps-hover hover:text-white">3D</button>
        <div class="hidden group-hover:block absolute left-0 top-full bg-ps-panel border border-ps-border shadow-2xl py-1 min-w-[200px] z-50 rounded-b">
          <a href="#" onclick="toggle3DOverlay()" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white block">Toggle 3D Mesh Render</a>
          <a href="#" onclick="open3DSettingsModal()" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white block">3D Mesh Wireframe Options</a>
        </div>
      </div>

      <!-- View -->
      <div class="relative group">
        <button class="px-2.5 py-1 rounded hover:bg-ps-hover hover:text-white">View</button>
        <div class="hidden group-hover:block absolute left-0 top-full bg-ps-panel border border-ps-border shadow-2xl py-1 min-w-[180px] z-50 rounded-b">
          <a href="#" onclick="zoomCanvas(0.1)" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white block">Zoom In (+10%)</a>
          <a href="#" onclick="zoomCanvas(-0.1)" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white block">Zoom Out (-10%)</a>
          <a href="#" onclick="resetCanvasZoom()" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white block">Fit to Screen (100%)</a>
        </div>
      </div>

      <!-- Plugins -->
      <div class="relative group">
        <button class="px-2.5 py-1 rounded hover:bg-ps-hover hover:text-white">Plugins</button>
        <div class="hidden group-hover:block absolute left-0 top-full bg-ps-panel border border-ps-border shadow-2xl py-1 min-w-[200px] z-50 rounded-b">
          <a href="#" onclick="triggerToast('KennMagic Core Engine v2.4 Active')" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white block">Magic Vector Engine</a>
          <a href="#" onclick="triggerToast('PSD Parser Module Ready')" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white block">PSD / TIF Import Plugin</a>
        </div>
      </div>

      <!-- Window -->
      <div class="relative group">
        <button class="px-2.5 py-1 rounded hover:bg-ps-hover hover:text-white">Window</button>
        <div class="hidden group-hover:block absolute left-0 top-full bg-ps-panel border border-ps-border shadow-2xl py-1 min-w-[180px] z-50 rounded-b">
          <a href="#" onclick="togglePanel('layersPanel')" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white flex items-center justify-between"><span>Layers Panel</span><i class="fa-solid fa-check text-[10px]"></i></a>
          <a href="#" onclick="togglePanel('historyPanel')" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white flex items-center justify-between"><span>History Panel</span><i class="fa-solid fa-check text-[10px]"></i></a>
          <a href="#" onclick="togglePanel('propertiesPanel')" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white flex items-center justify-between"><span>Properties Panel</span><i class="fa-solid fa-check text-[10px]"></i></a>
        </div>
      </div>

      <!-- Help -->
      <div class="relative group">
        <button class="px-2.5 py-1 rounded hover:bg-ps-hover hover:text-white">Help</button>
        <div class="hidden group-hover:block absolute left-0 top-full bg-ps-panel border border-ps-border shadow-2xl py-1 min-w-[200px] z-50 rounded-b">
          <a href="#" onclick="openAboutModal()" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white block">About Photo Magic...</a>
          <a href="#" onclick="triggerToast('System: Windows/macOS Desktop Mode Verified')" class="px-3 py-1.5 hover:bg-ps-accent hover:text-white block">System Diagnostics</a>
        </div>
      </div>
    </div>

    <!-- Right Side Toolbar Stats -->
    <div class="ml-auto flex items-center space-x-3 text-[11px] text-ps-muted">
      <span class="hidden md:inline"><i class="fa-solid fa-microchip mr-1"></i> RAM: <span class="text-gray-300">1.2 GB / 16 GB</span></span>
      <span class="bg-ps-bg border border-ps-border px-2 py-0.5 rounded text-gray-300 font-mono" id="canvasSizeBadge">1920 x 1080 px</span>
    </div>
  </nav>

  <!-- ================= MAIN CONTENT CONTAINER (HOME OR WORKSPACE) ================= -->
  <main class="flex-1 flex overflow-hidden relative">

    <!-- 1. HOME SCREEN / LAUNCHER DASHBOARD VIEW -->
    <section id="homeView" class="w-full h-full flex flex-col bg-ps-bg p-6 overflow-y-auto">
      <div class="max-w-6xl w-full mx-auto space-y-8">
        
        <!-- Welcome Hero Header -->
        <div class="flex flex-col md:flex-row items-center justify-between bg-ps-panel border border-ps-border rounded-xl p-6 shadow-xl relative overflow-hidden">
          <div class="absolute -right-10 -bottom-10 opacity-10 pointer-events-none">
            <i class="fa-solid fa-wand-magic-sparkles text-[220px] text-ps-accent"></i>
          </div>
          <div class="space-y-3 z-10 max-w-xl">
            <div class="flex items-center space-x-3">
              <span class="bg-ps-accent/20 text-ps-accent border border-ps-accent/40 text-xs px-2.5 py-1 rounded-full font-semibold uppercase tracking-wider">Photoshop 70%+ Engine</span>
              <span class="text-xs text-ps-muted">Owned by <strong class="text-gray-200">kennmagic</strong></span>
            </div>
            <h1 class="text-3xl font-bold text-white tracking-tight">Photo Magic Desktop Launcher</h1>
            <p class="text-ps-muted text-sm leading-relaxed">
              High-fidelity creative workspace with multi-format importer (PNG, JPG, SVG, PSD, TIF), full layer dynamic management, 3D low-poly wireframe rendering, and desktop administrator controls.
            </p>
            <div class="flex flex-wrap gap-3 pt-2">
              <button onclick="openNewModal()" class="px-5 py-2.5 bg-ps-accent hover:bg-ps-accentHover text-white font-medium rounded-lg text-sm flex items-center space-x-2 shadow-lg shadow-ps-accent/20 transition transform active:scale-95">
                <i class="fa-solid fa-plus text-xs"></i>
                <span>Create New File</span>
              </button>
              <label class="px-5 py-2.5 bg-ps-hover hover:bg-ps-border text-gray-200 border border-ps-border font-medium rounded-lg text-sm flex items-center space-x-2 cursor-pointer transition transform active:scale-95">
                <i class="fa-solid fa-folder-open text-amber-400 text-xs"></i>
                <span>Open / Import Image</span>
                <input type="file" accept=".png,.jpg,.jpeg,.svg,.psd,.tif,.tiff" class="hidden" onchange="handleFileImport(event)">
              </label>
              <button onclick="openSettingsModal()" class="px-4 py-2.5 bg-ps-panel hover:bg-ps-hover border border-ps-border text-gray-300 rounded-lg text-sm transition">
                <i class="fa-solid fa-gear mr-1.5"></i> App Settings
              </button>
            </div>
          </div>

          <!-- App Icon Showcase Badge -->
          <div class="mt-6 md:mt-0 flex flex-col items-center justify-center p-4 bg-ps-header/80 border border-ps-border rounded-xl z-10 w-48 text-center shadow-lg">
            <div class="w-24 h-24 rounded-2xl overflow-hidden shadow-2xl border border-ps-border mb-3 relative group">
              <svg viewBox="0 0 100 100" class="w-full h-full">
                <rect width="100" height="100" fill="url(#wolfBg)"/>
                <g stroke="#111111" stroke-width="1.2" stroke-linejoin="round">
                  <polygon points="50,15 35,32 50,42" fill="#a0a5b5"/>
                  <polygon points="50,15 50,42 65,32" fill="#c0c5d5"/>
                  <polygon points="35,32 20,25 30,48" fill="#787e8e"/>
                  <polygon points="65,32 80,25 70,48" fill="#989ea3"/>
                  <polygon points="50,42 30,48 50,65" fill="#888e9e"/>
                  <polygon points="50,42 50,65 70,48" fill="#a8aebf"/>
                  <polygon points="30,48 18,52 32,68" fill="#606573"/>
                  <polygon points="70,48 82,52 68,68" fill="#808593"/>
                  <polygon points="50,65 32,68 50,88" fill="#707584"/>
                  <polygon points="50,65 50,88 68,68" fill="#9095a4"/>
                  <polygon points="38,40 45,43 36,46" fill="#00d2ff" stroke="none"/>
                  <polygon points="62,40 55,43 64,46" fill="#00d2ff" stroke="none"/>
                </g>
              </svg>
            </div>
            <span class="text-xs font-bold text-gray-200">3D Wolf Structure</span>
            <span class="text-[10px] text-ps-muted">Official Icon Badge</span>
          </div>
        </div>

        <!-- Preset Templates Quick Launch Grid -->
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-ps-muted mb-4 flex items-center">
            <i class="fa-solid fa-shapes mr-2 text-ps-accent"></i> Preset Canvas Sizes
          </h2>
